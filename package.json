{
  "name": "xolum-fiscal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:up": "docker compose up -d postgres",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d postgres",
    "local:logs": "docker compose logs -f postgres",
    "local:check": "node scripts/local-db-check.mjs"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "next": "16.3.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "soap": "1.10.0",
    "xmllint-wasm": "5.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
