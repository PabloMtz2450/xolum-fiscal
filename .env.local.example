# XOLUM Fiscal local only
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=XOLUM Fiscal Local
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://xolum:xolum_local_2026@localhost:54329/xolum_fiscal
DATABASE_SSL=false

PAC_PROVIDER=finkok
PAC_ENVIRONMENT=SANDBOX
PAC_TIMEOUT_MS=30000
FINKOK_USERNAME=
FINKOK_PASSWORD=
FINKOK_CANCEL_CERTIFICATE_PEM_PATH=
FINKOK_CANCEL_PRIVATE_KEY_DES3_PEM_PATH=
FINKOK_CANCEL_STORE_PENDING=false

SAT_STATUS_PROVIDER=finkok
SAT_CATALOG_SNAPSHOT_DIR=./fiscal-assets/catalogs
SAT_XSD_BUNDLE_DIR=./fiscal-assets/xsd
SAT_CADENA_XSLT_PATH=./fiscal-assets/xslt/cadenaoriginal_4_0.xslt
XSLTPROC_EXECUTABLE=xsltproc
SAT_RULESET_VERSION=2026.08.22-core-2
FISCAL_FAIL_CLOSED=true

CSD_CERTIFICATE_PATH=
CSD_PRIVATE_KEY_PATH=
CSD_PRIVATE_KEY_PASSWORD=

ENABLE_SALES_LITE=true
ENABLE_XOLUM_TMS=false
XOLUM_TMS_BASE_URL=
XOLUM_TMS_API_KEY=
ENABLE_XOLUM_SALES_PRO=false
ENABLE_BANK_MATCHING=true

# Sólo desarrollo local. Producción bloquea secretos por env.
ALLOW_ENV_SECRETS=true
APP_ENCRYPTION_KEY=local-only-do-not-reuse-in-production-32bytes
SESSION_SECRET=local-only-session-secret-change-me
TRUST_PROXY=false
ALLOW_UNSAFE_DIRECT_STAMP=false
