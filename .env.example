# App
NEXT_PUBLIC_APP_NAME=XOLUM Fiscal
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database - production must require TLS and managed backups/PITR
DATABASE_URL=
DATABASE_SSL_REQUIRED=true
DATABASE_POOL_MAX=10

# PAC connector - FINKOK
PAC_PROVIDER=finkok
PAC_ENVIRONMENT=SANDBOX
PAC_TIMEOUT_MS=30000
FINKOK_USERNAME=
FINKOK_PASSWORD=
FINKOK_CANCEL_CERTIFICATE_PEM_PATH=
FINKOK_CANCEL_PRIVATE_KEY_DES3_PEM_PATH=
FINKOK_CANCEL_STORE_PENDING=false
# Must remain false in production: durable PostgreSQL flow is mandatory.
ALLOW_NON_DURABLE_STAMPING=false

# SAT status service / PAC proxy
SAT_STATUS_PROVIDER=finkok

# Fiscal validation assets
SAT_CATALOG_SNAPSHOT_DIR=./fiscal-assets/catalogs
SAT_XSD_BUNDLE_DIR=./fiscal-assets/xsd
SAT_CADENA_XSLT_PATH=./fiscal-assets/xslt/cadenaoriginal_4_0.xslt
XSLTPROC_EXECUTABLE=xsltproc
SAT_RULESET_VERSION=2026.08.22-core-2
FISCAL_FAIL_CLOSED=true

# CSD storage for local development only.
# Production must obtain CSD/PAC secrets from KMS/Secret Manager.
CSD_CERTIFICATE_PATH=
CSD_PRIVATE_KEY_PATH=
CSD_PRIVATE_KEY_PASSWORD=
ALLOW_ENV_SECRETS=false

# Object storage - private, encrypted, versioned and immutable in production
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KMS_KEY_ID=
OBJECT_STORAGE_REQUIRE_VERSIONING=true
OBJECT_STORAGE_REQUIRE_OBJECT_LOCK=true

# Included capability
ENABLE_SALES_LITE=true

# Optional modules
ENABLE_XOLUM_TMS=false
XOLUM_TMS_BASE_URL=
XOLUM_TMS_API_KEY=
ENABLE_XOLUM_SALES_PRO=false
ENABLE_BANK_MATCHING=false

# Security
APP_ENCRYPTION_KEY=
SESSION_SECRET=
TRUST_PROXY=false
RATE_LIMIT_BACKEND=memory
# Production: use redis/waf, never memory.
REDIS_URL=
MFA_REQUIRED_FOR_ADMIN=true
MFA_REQUIRED_FOR_CANCELLATION=true
MFA_MAX_AGE_MS=900000
