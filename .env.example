# App
NEXT_PUBLIC_APP_NAME=XOLUM Fiscal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=

# PAC connector
PAC_PROVIDER=mock
PAC_ENVIRONMENT=SANDBOX
PAC_BASE_URL=
PAC_API_KEY=
PAC_API_SECRET=
PAC_TIMEOUT_MS=30000

# SAT status service / PAC proxy
SAT_STATUS_PROVIDER=pac
SAT_STATUS_BASE_URL=

# Fiscal validation assets
SAT_CATALOG_SNAPSHOT_DIR=./fiscal-assets/catalogs
SAT_XSD_BUNDLE_DIR=./fiscal-assets/xsd
SAT_RULESET_VERSION=2026.08.22-core-2
FISCAL_FAIL_CLOSED=true

# CSD storage (reference only; never commit real certificates/keys)
CSD_CERTIFICATE_PATH=
CSD_PRIVATE_KEY_PATH=
CSD_PRIVATE_KEY_PASSWORD=

# Included capability
ENABLE_SALES_LITE=true

# Optional modules
ENABLE_XOLUM_TMS=false
XOLUM_TMS_BASE_URL=
XOLUM_TMS_API_KEY=
ENABLE_XOLUM_SALES_PRO=false
ENABLE_BANK_MATCHING=false

# Security
APP_ENCRYPTION_KEY=
SESSION_SECRET=
